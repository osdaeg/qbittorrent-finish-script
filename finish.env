# =============================================================================
# CONFIGURACIÓN
# =============================================================================

HOST="192.168.88.100"

# carpeta mapeada dentro del contenedor qbittorrent
BASEDIR=/config

GOTIFY_URL="http://${HOST}:8088"
GOTIFY_TOKEN="TuTokenDeGotify"

CLAMAV_URL="http://${HOST}:3311"
TRANSFERR_URL="http://${HOST}:7900"
BUTLER_URL="http://${HOST}:7999"
PASTEBIN_URL="http://${HOST}:8090"
QB_URL="http://gluetun:8081"

OPENSUBS_API_KEY="TuAPIKeyDeOpensubs"
OPENSUBS_USER="user"
OPENSUBS_PASS="pass"
OPENSUBS_URL="https://api.opensubtitles.com/api/v1"
OPENSUBS_USERAGENT="finish.sh v1.0"

SUBDL_API_KEY="TuAPIKeyDeSubDL"
SUBDL_URL="https://api.subdl.com/api/v1"
SUBDL_DL_URL="https://dl.subdl.com"

# Extensiones de video a excluir del escaneo antivirus
VIDEO_EXTENSIONS="mkv|mp4|avi|mov|wmv|m4v|ts|m2ts"

PASTE_ERRORS="yes"
SEND_NOTIFICATION="yes"
SCAN_FILES="yes"
GENERATE_BUTLER_CARD="yes"
TRANSFER_FILES="yes"
SEARCH_SUBTITLES="yes"

MUSIC_CATEGORY="musica"
COMIC_CATEGORY="comics"
MOVIES_CATEGORY="radarr"
SERIES_CATEGORY="sonarr"
BOOKS_CATEGORY="libros"

MUSIC_TRANSFER=("slskd")
BOOK_TRANSFER=("calibre" "booklore")
COMIC_TRANSFER=("comics")
MOVIE_TRANSFER=()
SERIES_TRANSFER=()

SONARR_URL="http://${HOST}:8989/api/v3"
SONARR_KEY="TuAPIKeyDeSonarr"

RADARR_URL="http://${HOST}:7878/api/v3"
RADARR_KEY="TuAPIKeyDeRadarr"

# Carpeta donde finish.sh deposita los .srt con nombre limpio. Debecser carpeta del host
SUBS_DIR="/ruta/donde/esta/qbittorrent/config/subs"

# Mapeo de rutas internas (Docker) a rutas del host
SONARR_PATH_INTERNAL="/tv"
SONARR_PATH_HOST="/ruta/del/host/donde/guardas/Series"

RADARR_PATH_INTERNAL="/movies"
RADARR_PATH_HOST="/ruta/del/host/donde/guardas/Películas"